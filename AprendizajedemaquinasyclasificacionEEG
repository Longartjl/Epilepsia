import numpy as np
import matplotlib.pyplot as plt
from sklearn.ensemble import RandomForestClassifier
from sklearn.model_selection import train_test_split
from sklearn.metrics import accuracy_score

print("=== INICIANDO DEPURACIÓN DEL MÓDULO 3 (MACHINE LEARNING) ===")

try:
    # 1. Simulación de datos sintéticos de EEG
    n_muestras = 300
    X_datos = []
    y_etiquetas = []
    
    for i in range(n_muestras):
        if i < 150:
            sig = np.random.normal(0, 0.4, 250)
            y_etiquetas.append(0) # Estado Interictal / Sano
        else:
            sig = np.random.normal(0, 1.6, 250) + np.sin(np.linspace(0, 30, 250)) * 2.5
            y_etiquetas.append(1) # Estado Ictal / Crisis
        X_datos.append(sig)

    # 2. Extracción de Características (Feature Engineering)
    X_features = []
    for sig in X_datos:
        line_length = np.sum(np.abs(np.diff(sig)))
        energia = np.sum(sig**2) / len(sig)
        X_features.append([line_length, energia])

    X_features = np.array(X_features)
    y_etiquetas = np.array(y_etiquetas)

    # 3. División y Entrenamiento del Modelo
    X_train, X_test, y_train, y_test = train_test_split(X_features, y_etiquetas, test_size=0.3, random_state=42)
    
    clf = RandomForestClassifier(n_estimators=30, random_state=42)
    clf.fit(X_train, y_train)
    
    # 4. Predicción y Métricas
    predicciones = clf.predict(X_test)
    acc = accuracy_score(y_test, predicciones)

    print(f"[OK] ¡Módulo 3 ejecutado sin errores!")
    print(f"-> Precisión del Clasificador EEG (Random Forest): {acc * 100:.2f}%")

except Exception as e:
    print(f"[ERROR DETECTADO]: {e}")
